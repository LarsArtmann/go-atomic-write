{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse/main/types/lighthouserc.d.ts",
  "ci": {
    "collect": {
      "url": [
        "https://atomicwrite.web.app",
        "https://atomicwrite.web.app/getting-started/installation/",
        "https://atomicwrite.web.app/getting-started/quick-start/",
        "https://atomicwrite.web.app/api-reference/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "dom-size": ["warn", { "maxNumericValue": 1500 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 900000 }],
        "uses-responsive-images": "off",
        "csp-xss": "off",
        "errors-in-console": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-deployed"
    }
  }
}
