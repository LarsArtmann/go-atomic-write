{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse/main/types/lighthouserc.d.ts",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/getting-started/installation/index.html",
        "http://localhost/getting-started/quick-start/index.html",
        "http://localhost/guides/error-handling/index.html",
        "http://localhost/guides/platform-support/index.html",
        "http://localhost/guides/benchmarks/index.html",
        "http://localhost/api-reference/index.html",
        "http://localhost/changelog/index.html",
        "http://localhost/contributing/index.html",
        "http://localhost/related-tools/index.html"
      ],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "total-byte-weight": ["error", { "maxNumericValue": 75000 }],
        "uses-responsive-images": "off",
        "csp-xss": "off",
        "errors-in-console": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
