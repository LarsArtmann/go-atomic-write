{
  "name": "go-atomic-write-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for go-atomic-write \u2014 crash-safe, race-free file writes for Go",
  "keywords": [
    "astro",
    "atomic-write",
    "crash-safety",
    "durability",
    "file-locking",
    "fsync",
    "go",
    "golang",
    "starlight",
    "toctou"
  ],
  "homepage": "https://atomicwrite.lars.software",
  "bugs": "https://github.com/larsartmann/go-atomic-write/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/larsartmann/go-atomic-write.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/sync-changelog.mjs",
    "build": "astro build",
    "prebuild": "node scripts/sync-changelog.mjs",
    "postbuild": "node scripts/fix-csp.mjs && node scripts/verify-build.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "validate": "html-validate dist/index.html",
    "lighthouse": "lhci autorun",
    "lighthouse:deployed": "lhci autorun --config=lighthouserc.deployed.json",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro",
    "brand:generate": "node ../scripts/generate-brand-assets.mjs",
    "brand:check": "node ../scripts/generate-brand-assets.mjs --check",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "check:hero": "node scripts/check-hero-source.mjs",
    "check": "pnpm run build && pnpm run check:hero && pnpm run audit:contrast && pnpm run validate && pnpm run typecheck"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@lhci/cli": "^0.16.0",
    "html-validate": "^11.18.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.20.0"
}
