---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
---

<SectionHeader title="Never lose a byte." subtitle="One fingerprint. Six writers. Zero corruption." />
<div class="text-center">
  <div class="flex items-center justify-center gap-3 flex-wrap">
    <a href="/getting-started/installation/" data-astro-prefetch class="px-7 py-3.5 bg-accent text-on-accent font-semibold rounded-lg text-sm hover:bg-accent-hover transition-all duration-200 inline-flex items-center gap-2 border-none cursor-pointer hover:-translate-y-0.5">
      Read the Docs
      <Icon name="arrow-right" size={16} />
    </a>
    <a href="/api-reference/" data-astro-prefetch class="px-6 py-3.5 border border-border text-text-secondary font-medium rounded-lg text-sm hover:border-border-hover hover:text-text-primary transition-all duration-200 inline-flex items-center gap-2 no-underline hover:-translate-y-0.5">
      API Reference
      <Icon name="arrow-external" size={16} />
    </a>
  </div>
  <p class="mt-8 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-xs font-mono text-text-muted">
    {['Write', 'WriteVerified', 'WriteIfChanged', 'WriteFunc', 'WriteFuncVerified', 'WriteWithPerm', 'WriteFuncWithPerm', 'FingerprintFile'].map((fn) => (
      <code class="px-2 py-1 rounded border border-border bg-bg-card text-text-secondary">{fn}</code>
    ))}
  </p>
</div>
