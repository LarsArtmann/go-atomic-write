---
import { faqItems } from '../data/sections';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
---

<SectionHeader eyebrow="Questions" title="The objections, answered." subtitle="Including when this library is the wrong tool for the job." />

<div class="grid gap-3 md:grid-cols-2 items-start">
  {faqItems.map((item) => (
    <details class="group rounded-xl border border-border bg-bg-card backdrop-blur-sm p-5 transition-colors duration-200 open:border-border-accent">
      <summary class="flex items-start justify-between gap-4 cursor-pointer list-none font-semibold text-text-primary text-sm [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <span class="shrink-0 mt-0.5 text-text-muted transition-transform duration-200 group-open:rotate-45">
          <Icon name="plus" size={16} />
        </span>
      </summary>
      <p class="mt-3 text-sm text-text-muted leading-relaxed">{item.answer}</p>
    </details>
  ))}
</div>
