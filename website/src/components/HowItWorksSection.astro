---
import SectionHeader from './SectionHeader.astro';
import { steps } from '../data/sections';
---

<SectionHeader title="Four phases. No window for corruption." subtitle="Every write passes through this pipeline. If any check fails, the original file is untouched." />

<div class="grid gap-3 lg:grid-cols-4 lg:gap-0 text-left relative">
  {steps.map((step, index) => (
    <div class={`relative p-5 rounded-lg border border-border bg-bg-card lg:rounded-none lg:border-r-0 lg:first:rounded-l-lg lg:last:rounded-r-lg lg:last:border-r ${step.stepColor === 'amber' ? 'lg:border-t-2 lg:border-t-amber/40' : 'lg:border-t-2 lg:border-t-accent/40'}`}>
      <div class="flex items-center gap-2.5 mb-3">
        <div class={`w-7 h-7 rounded-md flex items-center justify-center text-xs font-mono font-bold ${step.stepColor === 'accent' ? 'bg-accent-dim text-accent border border-border-accent' : 'bg-amber/10 text-amber border border-amber/30'}`}>{step.step}</div>
        <h3 class="font-semibold text-text-primary text-sm">{step.title}</h3>
      </div>
      <p class="text-xs text-text-muted leading-relaxed mb-3">{step.desc}</p>
      {step.code && (
        <code class="block bg-code-inline-bg/70 px-2.5 py-1.5 rounded text-[0.6875rem] text-accent font-mono leading-relaxed">{step.code}</code>
      )}
      {index < steps.length - 1 && (
        <div class="hidden lg:flex absolute top-1/2 -right-3 -translate-y-1/2 w-6 h-6 items-center justify-center text-accent z-10 bg-bg-primary border border-border rounded-full">
          <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 10 10" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 5h6m0 0L5.5 2.5M8 5L5.5 7.5" />
          </svg>
        </div>
      )}
    </div>
  ))}
</div>

<div class="mt-4 rounded-lg border border-editor-border bg-editor-surface overflow-hidden shadow-[0_16px_40px_-20px_rgba(3,10,8,0.5)]">
  <div class="border-l-2 border-l-amber px-5 py-4">
    <p class="text-xs font-mono text-editor-string mb-2">if fingerprint != disk</p>
    <p class="text-sm text-editor-muted leading-relaxed max-w-3xl">
      Stage 4 never runs: the temp file is discarded, the original file is left byte-for-byte
      untouched, and the caller gets <code class="text-editor-fn font-mono">ErrConcurrentModification</code> —
      not a lost update. Exactly one writer wins; the loser knows it and can retry with fresh data.
    </p>
  </div>
</div>
