---
export interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 28, height = 28, class: className } = Astro.props;
---

<svg class={className} width={width} height={height} viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="go-atomic-write logo">
  <rect width="28" height="28" rx="6" class="fill-[var(--color-accent)]" />
  <path d="M14 5L5 22h3.5l1.3-2.5h8.4L19.5 22H23L14 5zm0 6l2.5 5h-5l2.5-5z" class="fill-[var(--color-bg-primary)]" />
</svg>
