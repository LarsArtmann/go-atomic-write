---
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { useCases } from '../data/sections';
---

<SectionHeader title="Where lost updates cost hours." subtitle="Config, checkpoints, and lock files: read-modify-write cycles shared between processes." />

<div class="grid gap-x-10 gap-y-0 sm:grid-cols-2 max-w-4xl mx-auto">
  {useCases.map((useCase) => (
    <div class="flex items-start gap-4 py-5 border-b border-border">
      <div class="shrink-0 mt-0.5 text-accent">
        <Icon name={useCase.icon} size={18} />
      </div>
      <div>
        <h3 class="font-semibold text-text-primary text-sm mb-1">{useCase.title}</h3>
        <p class="text-xs text-text-muted leading-relaxed">{useCase.desc}</p>
      </div>
    </div>
  ))}
</div>
