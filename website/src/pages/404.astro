---
import LandingLayout from '../layouts/LandingLayout.astro';
import { siteConfig } from '../data/config';
---

<LandingLayout title={`404 — ${siteConfig.name}`}>
  <section class="min-h-[60vh] flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-lg">
      <p class="font-mono text-accent text-sm font-semibold tracking-widest uppercase mb-4">Error 404</p>
      <h1 class="font-sans text-text-primary text-5xl sm:text-6xl font-bold tracking-tight mb-6">
        Page not found
      </h1>
      <p class="text-text-secondary text-lg mb-10">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 font-semibold text-bg-primary transition-colors hover:bg-accent-hover">
          Back to home
        </a>
        <a href="/getting-started/quick-start/" class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 font-semibold text-text-primary transition-colors hover:border-border-hover">
          Read the docs
        </a>
      </div>
    </div>
  </section>
</LandingLayout>
